{
  "name": "workproof-execution-service",
  "version": "1.0.0",
  "description": "WorkProof AI Isolated Execution Boundary Service",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "node -e \"const fs=require('fs'); if(fs.existsSync('../missions')&&!fs.existsSync('./missions')){fs.cpSync('../missions','./missions',{recursive:true})}\" 2>/dev/null || true",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
