# Server Environment
PORT=5002
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/workproof-ai

# Security & Authentication (Replace with secure random secrets in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_placeholder
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_placeholder
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Execution Service Boundary Token
EXECUTION_SECRET=your_internal_execution_service_shared_secret_placeholder
EXECUTION_SERVICE_URL=http://localhost:5003

# AI Layer
GEMINI_API_KEY=your_gemini_api_key_placeholder
